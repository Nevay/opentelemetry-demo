{
    "name": "openteletry-demo/quote",
    "description": "Quote Service part of OpenTelemetry Demo",
    "license": "Apache-2.0",
    "require": {
        "php": ">= 8.3",
        "ext-json": "*",
        "ext-pcntl": "*",
        "monolog/monolog": "3.10.0",
        "open-telemetry/api": "1.8.0",
        "open-telemetry/opentelemetry-auto-slim": "1.3.0",
        "open-telemetry/opentelemetry-logger-monolog": "1.1.0",
        "revolt/event-loop-adapter-react": "^1.1",
        "php-di/php-di": "7.1.1",
        "php-di/slim-bridge": "3.4.1",
        "react/http": "v1.11.0",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.1",
        "tbachert/otel-sdk": "^0.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "tbachert/spi": true
        }
    }
}
